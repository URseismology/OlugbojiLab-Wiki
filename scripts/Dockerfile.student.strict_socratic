FROM jupyter/scipy-notebook:latest

# Install "jupyter-ai<3.0.0" for the Socratic coding assistant
RUN pip install --no-cache-dir jupyter-ai==2.31.7 langchain-ollama

# Bake the Jupyter-AI configuration so students automatically connect to Ollama
RUN mkdir -p /home/jovyan/.local/share/jupyter/jupyter_ai
COPY --chown=${NB_UID}:${NB_GID} jupyter_ai_config.json /home/jovyan/.local/share/jupyter/jupyter_ai/config.json

# Override Jupyter AI default system prompt to enforce STRICT Socratic Lab Persona
RUN python3 -c "import jupyter_ai_magics.base_provider as bp; file_path=bp.__file__.replace('.pyc', '.py'); content=open(file_path).read(); content=content.replace('You are Jupyternaut, a conversational assistant living in JupyterLab to help users.', 'You are a strict Socratic Coding Assistant designed specifically for Dr. Olugboji\'s Planetary Imaging and Earth Hazards Lab. Your goal is to guide students to the answer, not give it to them. CRITICAL RULES: 1. NEVER provide fully corrected copy-paste code blocks. 2. NEVER give the direct answer to a bug. 3. Instead, explain the underlying concept and ask the student a guiding question so they can fix the bug themselves. Always end your response with a question.'); open(file_path, 'w').write(content)"
